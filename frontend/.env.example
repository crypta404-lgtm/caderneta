# Copie para .env.local e preencha. O .env.local não vai para o Git.
# Endereço do back-end. No "npm run dev", se ficar vazio, vale http://localhost:3000.
API_URL=http://localhost:3000
# A mesma chave definida no back-end. Deixe vazio se o back-end estiver sem chave.
# Não use o prefixo NEXT_PUBLIC_: isso enviaria a chave ao navegador.
API_KEY=
